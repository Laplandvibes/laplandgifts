/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/images/*
  Cache-Control: public, max-age=31536000, immutable

/guides/*
  # 🔴 s-maxage 600, sama syy kuin /static/*-säännössä alla. Mitattu 6.8.2026:
  # apex-pyyntö 5 s deployn jälkeen tallensi SPA-kuoren PDF:n nimen alle, ja
  # ilman s-maxagea väärä vastaus olisi istunut reunalla vuorokauden (86400).
  # Selain saa pitää PDF:n tunnin; CDN:n kopio vanhenee 10 minuutissa.
  Cache-Control: public, max-age=3600, s-maxage=600

/static/*
  # 🔴 EI immutable. Tiedostonimi on sisältöhash, joten selain saa pitää sen
  # ikuisesti (max-age), mutta CDN:n kopio on vanhennuttava: jos assettia
  # pyydetään ennen kuin se on levinnyt reunalle, SPA-fallback vastaa
  # HTML:llä statuksella 200 ja se tallentuu tiedoston nimen alle. Kun
  # merkintä oli immutable, väärä vastaus jäi vuodeksi eikä sitä voinut
  # poistaa ilman purge-oikeutta: sivusto renderöityi tyhjänä tai
  # tyylittömänä. s-maxage rajaa vahingon 10 minuuttiin.
  Cache-Control: public, max-age=31536000, s-maxage=600
