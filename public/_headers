/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/images/*
  # 🔴 EI immutable, sama syy kuin /static/*- ja /guides/*-säännöissä alla.
  # Mitattu 12.8.2026: Muurla-lasipullon 320/480/640-variantit puuttuivat
  # yhdestä deploysta, ja niitä pyydettiin ennen kuin seuraava deploy oli
  # levinnyt reunalle. SPA-fallback vastasi HTML:llä statuksella 200, ja se
  # tallentui .avif-tiedoston nimen alle. `immutable` teki vahingosta
  # pysyvän: tuotekortissa näkyi pelkkä alt-teksti vielä sen jälkeen kun
  # oikea tiedosto oli livenä, eikä sitä voinut poistaa ilman
  # purge-oikeutta.
  #
  # Tuotekuvan nimi EI ole sisältöhash (`prod-<slug>-480.avif`), joten
  # selaimen ikuinen kopio on silti oikein: sama nimi tarkoittaa aina samaa
  # kuvaa. Vain CDN:n kopion on vanhennuttava, jotta väärä vastaus rajautuu
  # kymmeneen minuuttiin.
  Cache-Control: public, max-age=31536000, s-maxage=600

/guides/*
  # 🔴 s-maxage 600, sama syy kuin /static/*-säännössä alla. Mitattu 6.8.2026:
  # apex-pyyntö 5 s deployn jälkeen tallensi SPA-kuoren PDF:n nimen alle, ja
  # ilman s-maxagea väärä vastaus olisi istunut reunalla vuorokauden (86400).
  # Selain saa pitää PDF:n tunnin; CDN:n kopio vanhenee 10 minuutissa.
  Cache-Control: public, max-age=3600, s-maxage=600

/static/*
  # 🔴 EI immutable. Tiedostonimi on sisältöhash, joten selain saa pitää sen
  # ikuisesti (max-age), mutta CDN:n kopio on vanhennuttava: jos assettia
  # pyydetään ennen kuin se on levinnyt reunalle, SPA-fallback vastaa
  # HTML:llä statuksella 200 ja se tallentuu tiedoston nimen alle. Kun
  # merkintä oli immutable, väärä vastaus jäi vuodeksi eikä sitä voinut
  # poistaa ilman purge-oikeutta: sivusto renderöityi tyhjänä tai
  # tyylittömänä. s-maxage rajaa vahingon 10 minuuttiin.
  Cache-Control: public, max-age=31536000, s-maxage=600
